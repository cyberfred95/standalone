# Configuration LaraTranslate
# Documentation SDK: https://github.com/translated/lara-node

# Credentials LaraTranslate (obligatoires pour les scripts glossaires)
# Obtenir vos clés sur: https://laratranslate.com/account/api
LARA_ACCESS_KEY_ID=your_access_key_id_here
LARA_ACCESS_KEY_SECRET=your_access_key_secret_here

# Configuration du serveur
PORT=3000
NODE_ENV=development

# Configuration optionnelle pour l'upload de glossaires
# BATCH_SIZE=5
# DELAY_BETWEEN_BATCHES=2000
